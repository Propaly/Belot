{
  "name": "belot-mvp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
  "dev": "vite",
  "dev:server": "tsx server/index.ts",
  "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
  "build": "vite build",
  "preview": "vite preview",
  "sim": "tsx scripts/simulate.ts",
  "sim:fuzz": "tsx scripts/simulate.ts --agents random --games 500",
  "test:rules": "tsx scripts/test-rules.ts",
  "test:notation": "tsx scripts/test-notation.ts",
  "replay": "tsx scripts/replay.ts",
  "regress": "tsx scripts/regress.ts",
  "verify": "npm run typecheck && npm run test:rules && npm run test:notation && npm run replay -- --all --old",
  "typecheck": "tsc -b"
},
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.20.3",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  }
}